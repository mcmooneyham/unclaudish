{
  "description": "Unclaudish: lint the final message on Stop and file comments/prose on PreToolUse (deny with feedback so Claude revises), plus a one-line plain-language reminder each turn.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/lint_stop.py",
            "timeout": 15,
            "statusMessage": "Checking writing style"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/remind.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/lint_file.py",
            "timeout": 10,
            "statusMessage": "Checking file writing style"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/show_stats.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}